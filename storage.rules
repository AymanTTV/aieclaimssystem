rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rental documents & Invoices - Public read access for customers and recipients to view/download shared invoices, agreements, permits, and claim forms without login
    match /rentals/{rentalId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Direct and finance Invoices - Public read access for shared invoices
    match /invoices/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Profile pictures
    match /profile-pictures/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Vehicle images and documents
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Claims documents
    match /claims/{claimId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Fallback: Allow public read access to all documents (agreements, invoices, permits) and authenticated write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
